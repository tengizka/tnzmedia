# Supabase — только публичные ключи. Этот файл копируют в .env, в git не попадает.
#
#   SUPABASE_URL=https://xxxxxxxx.supabase.co
#   SUPABASE_ANON_KEY=eyJ...           # anon public, защищён RLS-политиками
#
# Серверные ключи (service_role / secret key) сюда НЕ класть: сборка публикует
# dist/ как есть, и любой ключ в ней увидит каждый посетитель.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# для GitHub Pages: полный адрес сайта без слэша на конце (нужен для canonical,
# og:image и sitemap). При своём домене поменяй и в src/data/site.json (baseUrl).
SITE_BASE_URL=https://tengizka.github.io/tnzmedia
